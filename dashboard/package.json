{
  "name": "eclipse-sentinel",
  "private": true,
  "version": "1.2.21",
  "description": "Eclipse Ultron — local-first AI command center powered by Sentinel runtime",
  "author": "Eclipse Forge <hello@eclipseforge.dev>",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "assets:brand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-installer-brand-assets.ps1",
    "electron:dev": "vite & sleep 2 && electron .",
    "electron:build": "npm run assets:brand && node scripts/build-ollama-console-host.mjs && npm run build && electron-builder --config.electronDist=node_modules/electron/dist",
    "lint": "eslint ."
  },
  "build": {
    "appId": "dev.eclipseforge.sentinel",
    "productName": "Eclipse Ultron",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "build/UltronOllamaHost.exe",
        "to": "runtime-host/UltronOllamaHost.exe"
      },
      {
        "from": "../scripts/voice-runtime",
        "to": "voice-runtime",
        "filter": [
          "runtime.mjs",
          "piper-runtime.mjs",
          "supervisor.mjs",
          "session.mjs",
          "dsp.mjs",
          "worker.py",
          "guard.py",
          "model-lock.json"
        ]
      },
      {
        "from": "../reports/voice-reference-2026-08-28/06-angry.mp3",
        "to": "voice-runtime/ultron-approved.mp3"
      },
      {
        "from": "../office",
        "to": "office",
        "filter": [
          "*.mjs",
          "*.ps1"
        ]
      },
      {
        "from": "build/eclipse-sentinel.ico",
        "to": "brand/eclipse-sentinel.ico"
      },
      {
        "from": "../scripts/sentinel-stt.ps1",
        "to": "voice/sentinel-stt.ps1"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/eclipse-sentinel.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Eclipse Ultron",
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ],
      "multiLanguageInstaller": true,
      "runAfterFinish": false,
      "installerIcon": "build/eclipse-sentinel.ico",
      "uninstallerIcon": "build/eclipse-sentinel.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "include": "build/installer.nsh",
      "artifactName": "Eclipse-Ultron-${version}-Setup.${ext}"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "framer-motion": "^12.38.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.15.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.2.2"
  }
}
